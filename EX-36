#include <stdio.h>

struct Block
{
    int blockNo;
    int data;
    int next;
};

int main()
{
    struct Block blocks[50];
    int n, i;
    int first, last;
    int current;

    printf("Enter number of disk blocks in the file: ");
    scanf("%d", &n);

    printf("\nEnter block details:\n");

    for (i = 0; i < n; i++)
    {
        printf("\nBlock %d\n", i + 1);

        printf("Enter block number: ");
        scanf("%d", &blocks[i].blockNo);

        printf("Enter data: ");
        scanf("%d", &blocks[i].data);

        if (i < n - 1)
        {
            printf("Enter next block number: ");
            scanf("%d", &blocks[i].next);
        }
        else
        {
            blocks[i].next = -1;
        }
    }

    /* Directory contains first and last block */
    first = blocks[0].blockNo;
    last = blocks[n - 1].blockNo;

    printf("\n===== DIRECTORY =====\n");
    printf("First Block : %d\n", first);
    printf("Last Block  : %d\n", last);

    printf("\n===== LINKED FILE ALLOCATION =====\n");

    current = first;

    while (current != -1)
    {
        for (i = 0; i < n; i++)
        {
            if (blocks[i].blockNo == current)
            {
                printf("Block %d -> Data = %d",
                       blocks[i].blockNo,
                       blocks[i].data);

                if (blocks[i].next != -1)
                    printf(" -> ");

                current = blocks[i].next;
                break;
            }
        }
    }

    printf("NULL\n");

    return 0;
}

