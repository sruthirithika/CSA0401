#include <stdio.h>

int main()
{
    int pages[50], frames[20];
    int n, f;
    int i, j, k;
    int pageFaults = 0, pageHits = 0;
    int found, pos;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter the page reference string:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &pages[i]);
    }

    printf("Enter number of frames: ");
    scanf("%d", &f);

    /* Initially all frames are empty */
    for (i = 0; i < f; i++)
    {
        frames[i] = -1;
    }

    printf("\nPage\tFrames\t\tStatus\n");
    printf("--------------------------------------\n");

    for (i = 0; i < n; i++)
    {
        found = 0;

        /* Check whether page is already in memory */
        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if (found)
        {
            pageHits++;

            printf("%d\t", pages[i]);

            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                    printf("- ");
                else
                    printf("%d ", frames[j]);
            }

            printf("\tHit\n");
        }
        else
        {
            pageFaults++;

            /* Find an empty frame */
            pos = -1;

            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            /* If no empty frame, find LRU page */
            if (pos == -1)
            {
                int leastRecent = i;
                pos = 0;

                for (j = 0; j < f; j++)
                {
                    int lastUsed = -1;

                    for (k = i - 1; k >= 0; k--)
                    {
                        if (frames[j] == pages[k])
                        {
                            lastUsed = k;
                            break;
                        }
                    }

                    if (lastUsed < leastRecent)
                    {
                        leastRecent = lastUsed;
                        pos = j;
                    }
                }
            }

            frames[pos] = pages[i];

            printf("%d\t", pages[i]);

            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                    printf("- ");
                else
                    printf("%d ", frames[j]);
            }

            printf("\tPage Fault\n");
        }
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);
    printf("Total Page Hits   = %d\n", pageHits);

    return 0;
}


