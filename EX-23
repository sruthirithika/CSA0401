#include <stdio.h>

int main() {
    int block[20], process[20], allocation[20];
    int m, n, i, j;

    printf("Enter number of memory blocks: ");
    scanf("%d", &m);

    printf("Enter size of each memory block:\n");
    for (i = 0; i < m; i++) {
        printf("Block %d: ", i + 1);
        scanf("%d", &block[i]);
    }

    printf("\nEnter number of processes: ");
    scanf("%d", &n);

    printf("Enter size of each process:\n");
    for (i = 0; i < n; i++) {
        printf("Process %d: ", i + 1);
        scanf("%d", &process[i]);
        allocation[i] = -1;
    }

    /* First Fit Allocation */
    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            if (block[j] >= process[i]) {
                allocation[i] = j;
                block[j] -= process[i];
                break;
            }
        }
    }

    printf("\n---------------------------------------------\n");
    printf("Process\tProcess Size\tBlock Allocated\n");
    printf("---------------------------------------------\n");

    for (i = 0; i < n; i++) {
        if (allocation[i] != -1) {
            printf("P%d\t%d\t\tB%d\n",
                   i + 1, process[i], allocation[i] + 1);
        } else {
            printf("P%d\t%d\t\tNot Allocated\n",
                   i + 1, process[i]);
        }
    }

    printf("---------------------------------------------\n");

    printf("\nRemaining Memory in Blocks:\n");
    for (i = 0; i < m; i++) {
        printf("Block %d = %d\n", i + 1, block[i]);
    }

    return 0;
}

